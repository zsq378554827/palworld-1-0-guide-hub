---
import type { VideoGuide } from "../data/videos";

type Props = { video: VideoGuide };
const { video } = Astro.props;
---

<a class="video-guide-card" href={`/videos/${video.slug}/`} aria-label={`Watch ${video.title}`}>
  <div class="video-card-image">
    <img src={video.thumbnail} alt="" width="1280" height="720" loading="lazy" decoding="async" />
    <span class="play-icon" aria-hidden="true"></span>
    <span class="video-duration">{video.displayDuration}</span>
  </div>
  <div class="video-card-copy">
    <p class="eyebrow">Video guide</p>
    <h3>{video.title}</h3>
    <p>{video.description}</p>
    <strong>Watch video guide →</strong>
  </div>
</a>

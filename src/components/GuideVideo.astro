---
import type { VideoGuide } from "../data/videos";

type Props = {
  video: VideoGuide;
};

const { video } = Astro.props;
---

<section class="guide-video" aria-labelledby="video-guide-heading" data-guide-video data-stream-url={video.streamUrl}>
  <div class="video-heading">
    <div>
      <p class="eyebrow">1080p60 direct-play video guide</p>
      <h2 id="video-guide-heading">{video.title}</h2>
    </div>
    <span>{video.displayDuration}</span>
  </div>
  <p>{video.description}</p>
  <div class="video-frame" data-video-frame>
    <video
      controls
      playsinline
      preload="metadata"
      poster={video.thumbnail}
      aria-label={video.title}
      data-guide-player
    >
      <p>Your browser cannot play this video.</p>
    </video>
  </div>
  <p class="video-playback-note" data-video-status>Plays directly on this site. No YouTube or Google login required.</p>
  <div class="video-chapters" aria-label="Video chapters">
    <h3>Jump to a step</h3>
    <div>
      {video.chapters.map((chapter) => (
        <button type="button" data-video-start={chapter.startSeconds}>
          <span>{Math.floor(chapter.startSeconds / 60)}:{String(chapter.startSeconds % 60).padStart(2, "0")}</span>
          {chapter.label}
        </button>
      ))}
    </div>
  </div>
  <noscript>
    <p>Enable JavaScript to play this video guide.</p>
  </noscript>
</section>

<script>
  import Hls from "hls.js";

  document.querySelectorAll<HTMLElement>("[data-guide-video]").forEach((root) => {
    const player = root.querySelector<HTMLVideoElement>("[data-guide-player]");
    const status = root.querySelector<HTMLElement>("[data-video-status]");
    const streamUrl = root.dataset.streamUrl;
    if (!player || !streamUrl) return;

    if (player.canPlayType("application/vnd.apple.mpegurl")) {
      player.src = streamUrl;
    } else if (Hls.isSupported()) {
      const hls = new Hls({
        capLevelToPlayerSize: true,
        enableWorker: true,
      });
      hls.loadSource(streamUrl);
      hls.attachMedia(player);
      hls.on(Hls.Events.ERROR, (_event, data) => {
        if (!data.fatal) return;
        if (data.type === Hls.ErrorTypes.NETWORK_ERROR) {
          hls.startLoad();
        } else if (data.type === Hls.ErrorTypes.MEDIA_ERROR) {
          hls.recoverMediaError();
        } else if (status) {
          status.textContent = "The video could not load. Please refresh the page and try again.";
        }
      });
    } else if (status) {
      status.textContent = "This browser does not support the site video player. Try a current version of Chrome, Safari, Edge, or Firefox.";
    }

    root.querySelectorAll<HTMLButtonElement>("[data-video-start]").forEach((button) => {
      button.addEventListener("click", async () => {
        player.currentTime = Number(button.dataset.videoStart ?? 0);
        player.scrollIntoView({ behavior: "smooth", block: "center" });
        try {
          await player.play();
        } catch {
          // The browser may require a second direct click on the native play control.
        }
      });
    });
  });
</script>

---
const navItems = [
  { href: "/", label: "Home" },
  { href: "/videos/", label: "Videos" },
  { href: "/guides/", label: "Guides" },
  { href: "/#tools", label: "Tools" },
  { href: "/server/", label: "Server" },
  { href: "/faq/", label: "FAQ" },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => href.includes("#") ? false : href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<header class="site-header">
  <a class="text-logo" href="/" aria-label="Palworld 1.0 Guide Hub home">
    <span>Palworld 1.0</span>
    <strong>Guide Hub</strong>
  </a>
  <nav class="site-nav" aria-label="Primary navigation">
    {navItems.map((item) => <a class:list={[isActive(item.href) && "active"]} href={item.href}>{item.label}</a>)}
  </nav>
  <form class="site-search" action="/guides/" method="get" role="search">
    <label class="visually-hidden" for="site-search-input">Search guides</label>
    <input id="site-search-input" name="q" type="search" placeholder="Search guides, videos, tools…" autocomplete="off" />
  </form>
</header>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../data/site";
---

<BaseLayout
  title="Disclaimer"
  description="Disclaimer for Palworld 1.0 Guide Hub, an unofficial fan-made guide site not affiliated with or endorsed by Pocketpair."
  canonical="/disclaimer/"
>
  <section class="page-hero compact">
    <p class="eyebrow">Disclaimer</p>
    <h1>Disclaimer</h1>
    <p>Legal and editorial notes for this unofficial fan-made guide site.</p>
  </section>

  <section class="text-page">
    <h2>Unofficial fan-made site</h2>
    <p>{site.disclaimer}</p>

    <h2>Accuracy</h2>
    <p>
      Palworld Version 1.0 information may change as official updates, patch notes, hotfixes, and platform-specific
      rollout details become available. Pre-release guides are written cautiously and should be checked again after launch.
    </p>

    <h2>Trademarks and assets</h2>
    <p>
      This site does not use the official Palworld logo as its site logo. Custom visual assets are fan-made and are used
      to support navigation and presentation, not to imply endorsement.
    </p>
  </section>
</BaseLayout>


---
import GuideCard from "../../components/GuideCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getGuideBySlug } from "../../data/guides";

const faqGuide = getGuideBySlug("guides/palworld-1-0-faq");
const faqs = [
  {
    question: "Is this an official Palworld site?",
    answer: "No. This is an unofficial fan-made guide site and is not affiliated with or endorsed by Pocketpair.",
  },
  {
    question: "Does this site include every Pal, item, and map location?",
    answer: "No. The MVP is a focused Palworld 1.0 guide hub, not a full database or Wiki.",
  },
  {
    question: "Is Palworld 1.0 live?",
    answer: "Yes. Palworld Version 1.0 is live, and Pocketpair has published the official release changelog through Steam.",
  },
  {
    question: "Should I start a new save for Palworld 1.0?",
    answer: "A fresh save is not required. Pocketpair says existing saves can continue, but recommends a new character for the reworked experience.",
  },
  {
    question: "Should I remove old MODs before updating?",
    answer: "Yes. Remove old MOD files and loaders, verify game files, and test Version 1.0 unmodded before restoring compatible MODs.",
  },
  {
    question: "What are Sunreach and the World Tree?",
    answer: "Sunreach is a new floating-island region, while the World Tree is central to the reworked story and endgame challenge.",
  },
  {
    question: "Are there new Pals?",
    answer: "Yes. Version 1.0 adds 47 new Pals and 25 variants, for 72 additions and 287 Pals in total.",
  },
];
---

<BaseLayout
  title="Palworld 1.0 Questions and Answers"
  description="Official-source Palworld 1.0 FAQ covering release status, old saves, fresh characters, MOD cleanup, Sunreach, the World Tree, new Pals, and servers."
  canonical="/faq/"
>
  <section class="page-hero compact">
    <p class="eyebrow">FAQ</p>
    <h1>Palworld 1.0 FAQ</h1>
    <p>Official-source answers about Palworld 1.0 saves, MODs, new regions, Pals, servers, and what still needs in-game verification.</p>
  </section>

  <section class="faq-list">
    {faqs.map((item) => (
      <details>
        <summary>{item.question}</summary>
        <p>{item.answer}</p>
      </details>
    ))}
  </section>

  {faqGuide && (
    <section class="section-wrap">
      <div class="section-heading">
        <h2>Full FAQ article</h2>
      </div>
      <div class="card-grid single">
        <GuideCard guide={faqGuide} />
      </div>
    </section>
  )}
</BaseLayout>

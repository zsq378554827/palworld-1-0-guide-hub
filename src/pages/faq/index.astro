---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getGuideBySlug } from "../../data/guides";

const faqGuide = getGuideBySlug("guides/palworld-1-0-faq");
const faqs = faqGuide?.faqs ?? [];
---

<BaseLayout
  title="Palworld 1.0 FAQ: Saves, MODs, Sunreach, Pals and Servers"
  description="Complete Palworld 1.0 FAQ based on Pocketpair's official changelog, covering release status, old saves, fresh characters, MODs, Sunreach, the World Tree, new Pals, servers, and returning players."
  canonical="/faq/"
>
  <section class="page-hero compact">
    <p class="eyebrow">Complete FAQ</p>
    <h1>Palworld 1.0 FAQ</h1>
    <p>Palworld 1.0 is live and the official v1.0 changelog is available. These answers separate confirmed facts from recommendations that still need player testing.</p>
  </section>

  <section class="section-wrap">
    <aside class="update-notice">
      <strong>Official-source status</strong>
      <p>Existing saves can continue, Pocketpair recommends a new character for the reworked experience, and old MOD files should be removed before testing Version 1.0.</p>
      <span>Last Updated: July 10, 2026</span>
    </aside>
  </section>

  <section class="faq-list">
    {faqs.map((item) => (
      <details>
        <summary>{item.question}</summary>
        <p>{item.answer}</p>
      </details>
    ))}
  </section>

  <section class="section-wrap">
    <div class="section-heading">
      <h2>What remains player-tested</h2>
      <p>Best Pals, exact routes, ideal server multipliers, hardware-specific performance, MOD compatibility, and long-session multiplayer stability still need in-game verification.</p>
    </div>
    <div class="compact-link-grid">
      <a href="/palworld-1-0/palworld-1-0-patch-notes-explained/"><strong>Patch Notes Explained</strong></a>
      <a href="/guides/should-you-start-a-new-save-in-palworld-1-0/"><strong>New Save Decision Guide</strong></a>
      <a href="/guides/palworld-1-0-returning-player-guide/"><strong>Returning Player Guide</strong></a>
    </div>
  </section>

  <section class="source-box section-wrap">
    <h2>Source note</h2>
    <p>This unofficial FAQ paraphrases Pocketpair's official Palworld v1.0 Steam changelog and MOD warning. It does not reproduce the announcements or certify untested rankings, routes, settings, or MODs.</p>
  </section>
</BaseLayout>

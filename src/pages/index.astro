---
import BaseLayout from "../layouts/BaseLayout.astro";
import AdvancedTipsSection from "../components/AdvancedTipsSection.astro";
import VideoGuideCard from "../components/VideoGuideCard.astro";
import { videos } from "../data/videos";
import { absoluteUrl, site } from "../data/site";

const taskLinks = [
  {
    number: "01",
    title: "Start a New World",
    description: "Follow a safe first-session route and build a flexible starter base.",
    href: "/guides/palworld-1-0-beginner-guide/",
  },
  {
    number: "02",
    title: "Return Safely",
    description: "Back up your save, remove MOD risks, and review the major changes.",
    href: "/guides/palworld-1-0-returning-player-guide/",
  },
  {
    number: "03",
    title: "Understand v1.0",
    description: "See the official changes and what still needs player verification.",
    href: "/palworld-1-0/palworld-1-0-patch-notes-explained/",
  },
  {
    number: "04",
    title: "Set Up a Server",
    description: "Update, validate, and reopen a dedicated server with fewer risks.",
    href: "/server/palworld-1-0-server-setup-guide/",
  },
  {
    number: "05",
    title: "Fix Performance",
    description: "Diagnose FPS, stutter, crashes, and multiplayer-specific issues.",
    href: "/guides/palworld-1-0-performance-settings/",
  },
  {
    number: "06",
    title: "Clean Up MODs",
    description: "Use a controlled cleanup and compatibility test before playing.",
    href: "/guides/palworld-1-0-mods-warning-compatibility-guide/",
  },
];

const categoryLinks = [
  { label: "Getting Started", href: "/guides/" },
  { label: "Version 1.0", href: "/palworld-1-0/" },
  { label: "Regions", href: "/palworld-1-0/palworld-1-0-sunreach-guide/" },
  { label: "Base Building", href: "/base-building/" },
  { label: "Server", href: "/server/" },
  { label: "Troubleshooting", href: "/guides/palworld-1-0-performance-settings/" },
];

const tools = [
  {
    number: "A",
    title: "Save Backup Checklist",
    label: "Checklist",
    description: "Protect world, player, and server data before changing the game build.",
    action: "Open checklist",
    href: "/guides/should-you-start-a-new-save-in-palworld-1-0/",
  },
  {
    number: "B",
    title: "Server Update Checklist",
    label: "Checklist",
    description: "Move through backup, version checks, MOD cleanup, testing, and reopening.",
    action: "Open checklist",
    href: "/server/palworld-1-0-server-owner-checklist/",
  },
  {
    number: "C",
    title: "Server Settings Framework",
    label: "Guide",
    description: "Choose a safe approach for casual, small-group, or long-term worlds.",
    action: "Compare approaches",
    href: "/server/palworld-1-0-best-server-settings/",
  },
];

const guideGroups = [
  {
    title: "New Players",
    links: [
      ["Beginner Guide", "/guides/palworld-1-0-beginner-guide/"],
      ["First Hour Checklist", "/guides/palworld-1-0-first-hour-checklist/"],
      ["Fast Early-Game Route", "/guides/palworld-1-0-fast-early-game-start-route/"],
      ["Ultimate Worker Pal Build", "/guides/palworld-1-0-ultimate-worker-pal-build/"],
      ["Level 8 Worker Pal Locations", "/guides/palworld-1-0-level-8-worker-pals-locations/"],
    ],
    all: ["View new player guides", "/guides/"],
  },
  {
    title: "Returning Players",
    links: [
      ["Returning Player Guide", "/guides/palworld-1-0-returning-player-guide/"],
      ["Keep or Restart Your Save", "/guides/should-you-start-a-new-save-in-palworld-1-0/"],
      ["MOD Cleanup Guide", "/guides/palworld-1-0-mods-warning-compatibility-guide/"],
    ],
    all: ["View returning player guides", "/guides/"],
  },
  {
    title: "Server Owners",
    links: [
      ["Dedicated Server Setup", "/server/palworld-1-0-server-setup-guide/"],
      ["Server Owner Checklist", "/server/palworld-1-0-server-owner-checklist/"],
      ["Settings Framework", "/server/palworld-1-0-best-server-settings/"],
    ],
    all: ["View server guides", "/server/"],
  },
  {
    title: "Version 1.0",
    links: [
      ["Patch Notes Explained", "/palworld-1-0/palworld-1-0-patch-notes-explained/"],
      ["Sunreach Guide", "/palworld-1-0/palworld-1-0-sunreach-guide/"],
      ["World Tree Guide", "/palworld-1-0/palworld-1-0-world-tree-guide/"],
    ],
    all: ["View all Version 1.0 guides", "/palworld-1-0/"],
  },
];

const featuredVideo = videos.find((video) => video.featured) ?? videos[0];
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.name,
  alternateName: "Palworld Guide Hub",
  url: absoluteUrl("/"),
  description: site.description,
  potentialAction: {
    "@type": "SearchAction",
    target: `${absoluteUrl("/guides/")}?q={search_term_string}`,
    "query-input": "required name=search_term_string",
  },
};
---

<BaseLayout
  title="Palworld 1.0 Guides, Videos, Checklists & Server Help"
  description="Palworld 1.0 guides for beginners, returning players, performance fixes, servers, MOD safety, videos, checklists, and official update help."
  canonical="/"
  structuredData={structuredData}
>
  <section class="home-dashboard" aria-labelledby="home-title">
    <div class="home-task-panel">
      <h1 id="home-title">What do you need help with?</h1>
      <p class="home-intro">Pick a task to get the right help in minutes.</p>
      <div class="task-grid">
        {taskLinks.map((task) => (
          <a class="task-card" href={task.href}>
            <span class="task-number">{task.number}</span>
            <span>
              <strong>{task.title}</strong>
              <small>{task.description}</small>
            </span>
            <span class="card-arrow">Open</span>
          </a>
        ))}
      </div>
    </div>

    {featuredVideo && (
      <a class="home-featured-video" href={`/videos/${featuredVideo.slug}/`} aria-label={`Watch ${featuredVideo.title}`}>
        <div class="featured-video-media">
          <img src={featuredVideo.thumbnail} alt="" width="1280" height="720" loading="eager" decoding="async" />
          <span class="play-icon" aria-hidden="true"></span>
          <span class="video-duration">{featuredVideo.displayDuration}</span>
        </div>
        <div class="featured-video-copy">
          <p class="eyebrow">Featured video guide</p>
          <h2>{featuredVideo.title}</h2>
          <p>{featuredVideo.description}</p>
          <strong>Watch the direct-play video →</strong>
        </div>
      </a>
    )}
  </section>

  <nav class="home-category-nav" aria-label="Browse guide categories">
    {categoryLinks.map((item, index) => (
      <a class:list={[index === 0 && "active"]} href={item.href}>{item.label}</a>
    ))}
  </nav>

  <section class="home-content-section" id="videos" aria-labelledby="video-guides-title">
    <div class="home-section-heading">
      <div>
        <h2 id="video-guides-title">Latest Video Guides</h2>
      </div>
      <a href="/videos/">View all videos</a>
    </div>
    <div class="video-library-grid home-video-grid">
      {videos.map((video) => <VideoGuideCard video={video} />)}
    </div>
  </section>

  <AdvancedTipsSection />

  <section class="home-content-section home-tools" id="tools" aria-labelledby="tools-title">
    <div class="home-section-heading">
      <div>
        <p class="home-kicker">Practical planning aids</p>
        <h2 id="tools-title">Useful checklists and frameworks</h2>
      </div>
    </div>
    <div class="tool-grid">
      {tools.map((tool) => (
        <a class="tool-card" href={tool.href}>
          <span class="tool-number">{tool.number}</span>
          <span class="tool-copy">
            <span class="tool-title-line">
              <strong>{tool.title}</strong>
              <small>{tool.label}</small>
            </span>
            <span>{tool.description}</span>
            <em>{tool.action}</em>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="home-content-section written-guide-section" aria-labelledby="written-guides-title">
    <div class="home-section-heading">
      <div>
        <p class="home-kicker">Browse by player situation</p>
        <h2 id="written-guides-title">Essential written guides</h2>
      </div>
    </div>
    <div class="guide-group-grid">
      {guideGroups.map((group, index) => (
        <div class="guide-group">
          <span class="group-number">0{index + 1}</span>
          <h3>{group.title}</h3>
          <ul>
            {group.links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
          </ul>
          <a class="group-all-link" href={group.all[1]}>{group.all[0]}</a>
        </div>
      ))}
    </div>
  </section>

  <aside class="home-release-note" aria-label="Content verification note">
    <strong>Palworld 1.0 is live.</strong>
    <span>The official v1.0 changelog is available. Player-tested recommendations are labeled separately from official facts.</span>
    <a href="/palworld-1-0/palworld-1-0-patch-notes-explained/">Read the changelog guide</a>
  </aside>
</BaseLayout>

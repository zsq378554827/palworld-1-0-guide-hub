---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GuideVideo from "../../components/GuideVideo.astro";
import { absoluteUrl } from "../../data/site";
import { videos } from "../../data/videos";

export function getStaticPaths() {
  return videos.map((video) => ({
    params: { slug: video.slug },
    props: { video },
  }));
}

const { video } = Astro.props;
const canonical = `/videos/${video.slug}/`;
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "VideoObject",
    name: video.title,
    description: video.description,
    thumbnailUrl: [absoluteUrl(video.thumbnail)],
    uploadDate: video.uploadDate,
    duration: video.duration,
    contentUrl: absoluteUrl(video.streamUrl),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: absoluteUrl("/") },
      { "@type": "ListItem", position: 2, name: "Video Guides", item: absoluteUrl("/videos/") },
      { "@type": "ListItem", position: 3, name: video.title, item: absoluteUrl(canonical) },
    ],
  },
];
---

<BaseLayout
  title={`${video.title} Video Guide`}
  description={video.description}
  canonical={canonical}
  image={video.thumbnail}
  type="article"
  structuredData={structuredData}
>
  <article class="video-page-shell">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/videos/">Videos</a>
    </nav>

    <header class="video-page-header">
      <p class="eyebrow">English video guide · {video.displayDuration}</p>
      <h1>{video.title}</h1>
      <p>{video.description}</p>
    </header>

    <GuideVideo video={video} />

    <div class="video-page-details">
      <aside class="video-verification">
        <p class="eyebrow">{video.verificationLabel}</p>
        <h2>Verification note</h2>
        <p>{video.verificationText}</p>
        <small>{video.sourceDisclosure}</small>
      </aside>

      <aside class="video-written-guide">
        <p class="eyebrow">Prefer text?</p>
        <h2>Open the separate written walkthrough</h2>
        <p>The full steps, tables, FAQs, sources, and patch-sensitive notes live on a dedicated article page.</p>
        <a class="button primary" href={video.guidePath}>{video.guideTitle}</a>
      </aside>
    </div>
  </article>
</BaseLayout>

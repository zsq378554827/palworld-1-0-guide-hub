---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { advancedTipChapters, advancedTips, advancedTipsGuide } from "../../data/advancedTips";
import { absoluteUrl } from "../../data/site";

const canonical = "/guides/palworld-1-0-tips/";
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: advancedTipsGuide.title,
    description: advancedTipsGuide.description,
    image: absoluteUrl(advancedTipsGuide.visual?.src ?? "/assets/palworld-guide-og.png"),
    datePublished: "2026-07-14T00:00:00+08:00",
    dateModified: "2026-07-14T00:00:00+08:00",
    author: { "@type": "Organization", name: "Palworld 1.0 Guide Hub", url: absoluteUrl("/about/") },
    publisher: { "@type": "Organization", name: "Palworld 1.0 Guide Hub", url: absoluteUrl("/") },
    mainEntityOfPage: absoluteUrl(canonical),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: absoluteUrl("/") },
      { "@type": "ListItem", position: 2, name: "Guides", item: absoluteUrl("/guides/") },
      { "@type": "ListItem", position: 3, name: advancedTipsGuide.title, item: absoluteUrl(canonical) },
    ],
  },
];
---

<BaseLayout
  title={advancedTipsGuide.title}
  description={advancedTipsGuide.description}
  canonical={canonical}
  image={advancedTipsGuide.visual?.src}
  type="article"
  structuredData={structuredData}
>
  <article class="article-shell advanced-tips-article">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/guides/">Guides</a>
    </nav>

    <header class="article-header advanced-article-header">
      <p class="eyebrow">Palworld 1.0 advanced tips</p>
      <h1>{advancedTipsGuide.title}</h1>
      <p class="lede">{advancedTipsGuide.description}</p>
      <div class="article-meta">
        <span>Last Updated: {advancedTipsGuide.lastUpdated}</span>
        <span>{advancedTipsGuide.readingTime}</span>
        <span>{advancedTips.length} illustrated tips</span>
      </div>
    </header>

    <aside class="advanced-trust-note" aria-label="Verification note">
      <div>
        <strong>What was corrected</strong>
        <p>
          The supplied source images mix useful strategy with older or unverified numbers. Version 1.0 officially reduced
          Capture Bonuses from twelve captures to five; fixed levels, percentages, reward pools and perfect-inheritance
          claims are labeled when they still need a current-build test.
        </p>
      </div>
      <a href="#sources">See the official source</a>
    </aside>

    <section class="advanced-short-answer" aria-labelledby="short-answer-title">
      <p class="eyebrow">Short answer</p>
      <h2 id="short-answer-title">Remove the bottleneck that ends your session</h2>
      <p>{advancedTipsGuide.shortAnswer}</p>
    </section>

    <nav class="advanced-toc" aria-label="Table of contents">
      <strong>Jump to a chapter</strong>
      <div>
        {advancedTipChapters.map((chapter) => (
          <a href={`#${chapter.id}`}><span>0{chapter.number}</span>{chapter.eyebrow}</a>
        ))}
      </div>
    </nav>

    <div class="advanced-article-chapters">
      {advancedTipChapters.map((chapter) => (
        <section class="advanced-article-chapter" id={chapter.id} aria-labelledby={`${chapter.id}-title`}>
          <header>
            <span>Part 0{chapter.number}</span>
            <div>
              <p>{chapter.eyebrow}</p>
              <h2 id={`${chapter.id}-title`}>{chapter.title}</h2>
              <small>{chapter.description}</small>
            </div>
          </header>

          <div class="advanced-article-tips">
            {chapter.tips.map((tip) => (
              <section class="advanced-article-tip" id={tip.id} aria-labelledby={`${tip.id}-title`}>
                <figure>
                  <img src={tip.image} alt={tip.alt} width="1200" height="675" loading="lazy" decoding="async" />
                  <figcaption>{tip.caption}</figcaption>
                </figure>
                <div class="advanced-article-tip-copy">
                  <div class="advanced-tip-meta">
                    <span>Tip {String(tip.number).padStart(2, "0")}</span>
                    <em class:list={[tip.verification === "Needs current-build test" && "needs-test"]}>{tip.verification}</em>
                  </div>
                  <h3 id={`${tip.id}-title`}>{tip.title}</h3>
                  <p class="tip-summary">{tip.summary}</p>
                  {tip.detail.map((paragraph) => <p>{paragraph}</p>)}
                  <h4>Do this next</h4>
                  <ul>{tip.actions.map((action) => <li>{action}</li>)}</ul>
                  {tip.related && <a class="tip-related-link" href={tip.related.href}>{tip.related.label} →</a>}
                </div>
              </section>
            ))}
          </div>
        </section>
      ))}
    </div>

    <section class="article-faq advanced-faq">
      <h2>Palworld 1.0 tips FAQ</h2>
      {advancedTipsGuide.faqs.map((item) => (
        <details>
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </section>

    <section class="source-box" id="sources">
      <h2>Sources and verification</h2>
      <p>
        Official feature statements were checked against Pocketpair's Version 1.0 release changelog. Strategy, fastest-route,
        fixed-value and source-footage claims remain labeled separately until independently tested on the current build.
      </p>
      <ul>
        {advancedTipsGuide.sourceLinks?.map((source) => (
          <li><a href={source.href} rel="nofollow noopener" target="_blank">{source.label}</a></li>
        ))}
      </ul>
    </section>

    <section class="related-guides">
      <h2>Continue with a focused guide</h2>
      <div class="compact-link-grid">
        {advancedTipsGuide.relatedLinks?.map((item) => <a href={item.href}><strong>{item.label}</strong></a>)}
      </div>
    </section>
  </article>
</BaseLayout>

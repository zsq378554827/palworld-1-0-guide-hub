---
import GuideCard from "../../components/GuideCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getGuidesByTag } from "../../data/guides";
import { collectionStructuredData } from "../../data/site";

const baseRelated = getGuidesByTag("base-building");
const title = "Palworld 1.0 Base Building Guide";
const description = "Palworld 1.0 base building changes, including Aquatic Construction, Work Suitability level 10, wave raids, defenses, and an old-base checklist.";
const structuredData = collectionStructuredData(
  title,
  description,
  "/base-building/",
  baseRelated.map((guide) => ({ name: guide.title, path: `/${guide.slug}/` })),
);
---

<BaseLayout
  title={title}
  description={description}
  canonical="/base-building/"
  structuredData={structuredData}
>
  <section class="page-hero compact">
    <p class="eyebrow">Base Building</p>
    <h1>Palworld 1.0 Base Building Changes Explained</h1>
    <p>Palworld 1.0 is live. The official changelog confirms major changes to construction, Base Pal work and raids; optimized layouts and best locations still need player testing.</p>
  </section>

  <section class="section-wrap two-column">
    <div>
      <h2>Confirmed Version 1.0 changes</h2>
      <ul class="check-list">
        <li><strong>Aquatic Construction:</strong> players can build along shorelines and offshore areas.</li>
        <li><strong>Work Suitability level 10:</strong> suitability now extends to ten levels and Pal work values were rebalanced.</li>
        <li><strong>Wave-based raids:</strong> raids arrive in successive waves and provide completion rewards.</li>
        <li><strong>Ammunition-free defenses:</strong> defense structures no longer consume ammunition while operating.</li>
        <li><strong>Base Pal work changes:</strong> work priorities, resource distribution, pathing-related behavior and multiple work issues were adjusted.</li>
      </ul>
    </div>
    <div>
      <h2>What old base owners should check first</h2>
      <ul class="check-list">
        <li>Back up the world before restructuring an important base.</li>
        <li>Inspect every assigned Pal's current Work Suitability and priorities.</li>
        <li>Check paths, storage access and production queues after loading the base.</li>
        <li>Review defenses before the first wave-based raid reaches the base.</li>
        <li>Keep old layouts flexible until throughput and raid pressure are measured.</li>
      </ul>
    </div>
  </section>

  <section class="section-wrap">
    <div class="section-heading">
      <h2>What still needs in-game verification</h2>
      <p>Best Base Locations, optimal Pal assignments, highest-throughput layouts, defense placement and raid scaling depend on real worlds and should not be treated as settled yet.</p>
    </div>
  </section>

  <section class="section-wrap">
    <div class="section-heading"><h2>Related guides</h2></div>
    <div class="card-grid">{baseRelated.map((guide) => <GuideCard guide={guide} />)}</div>
  </section>
</BaseLayout>
